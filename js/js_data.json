{
    "persona": {
        "label": "Dune Beach Explorer",
        "tone": "Adventurous, sunny, natural",
        "visual_intensity": "medium",
        "risk_tolerance": "expressive"
    },
    "tokens": {
        "colors": {
            "primary": "#f7fafc",
            "secondary": "#edf2f7",
            "accent": "#e2e8f0",
            "bg": "#ffffff",
            "text": "#a0aec0",
            "hover": "#a0aec0",
            "active": "#718096",
            "focus": "#f7fafc",
            "success": "#38a169",
            "error": "#e53e3e",
            "warning": "#d69e2e",
            "info": "#3182ce",
            "neutral": "#f7fafc",
            "link": "#edf2f7",
            "border": "#e2e8f0",
            "surface": "#ffffff",
            "gradient_bg": "linear-gradient(to top, #ffffff, #f7fafc)"
        },
        "typography": {
            "primary_font": "'Bitter', system-ui, sans-serif",
            "base_size": "16px",
            "line_height": "1.65",
            "heading_sizes": [
                "2.8rem",
                "2.3rem",
                "1.9rem",
                "1.6rem",
                "1.4rem",
                "1.2rem"
            ]
        },
        "spacing": {
            "xs": "4px",
            "s": "8px",
            "m": "16px",
            "l": "32px",
            "xl": "48px",
            "xxl": "72px"
        },
        "borders": {
            "radius": "6px"
        },
        "shadows": {
            "low": "0 4px 8px rgba(160,174,192,0.05)",
            "medium": "0 10px 20px rgba(160,174,192,0.1)"
        },
        "motion": {
            "timing": "0.5s ease-in-out"
        },
        "breakpoints": {
            "tablet": "700px",
            "desktop": "1000px"
        },
        "animations": {
            "duration_base": 0.5,
            "ease_default": "easeInOutExpo",
            "intensity_mod": 1.0,
            "risk_ease": "bounce.out",
            "mobile_mod": 0.75
        }
    },
    "animation_customizations": {
        "hero": {
            "from": {
                "opacity": 0,
                "y": 50
            },
            "to": {
                "opacity": 1,
                "y": 0
            }
        },
        "cta": {
            "hover": {
                "scale": 1.05
            },
            "leave": {
                "scale": 1
            }
        },
        "form": {
            "stagger": 0.1,
            "from": {
                "opacity": 0
            }
        },
        "list": {
            "stagger": 0.2,
            "from": {
                "opacity": 0,
                "x": -50
            }
        },
        "content": {
            "from": {
                "opacity": 0
            },
            "to": {
                "opacity": 1
            }
        },
        "mobile_mod": 0.8
    }
}